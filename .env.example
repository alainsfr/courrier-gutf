APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Scheduled times only; application dates stay in UTC.
SCHEDULE_TIMEZONE=Africa/Douala

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_IDLE_TIMEOUT=30
SESSION_IDLE_WARNING_SECONDS=120
SESSION_COOKIE=courrier-gutf-session
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# En production HTTPS : SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_EXPIRE_ON_CLOSE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_TIMEOUT=30
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Chemin vers le dossier contenant mysqldump (vide = PATH systÃ¨me / production).
# Windows XAMPP ex. : DB_DUMP_PATH=C:/xampp/mysql/bin  (utiliser / , pas \ en fin de chemin)
DB_DUMP_PATH=

# URL publique relative des fichiers (logo, favicon, avatars). Défaut : /storage
FILESYSTEM_PUBLIC_URL=/storage

# Premier super-admin (production : obligatoire, utilisé uniquement si le compte n'existe pas encore)
# SUPER_ADMIN_NAME="Super Admin"
# SUPER_ADMIN_EMAIL=admin@institution.cm
# SUPER_ADMIN_PASSWORD=
